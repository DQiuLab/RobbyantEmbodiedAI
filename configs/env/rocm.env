# 初版 AMD 方案，未用于最终权重。AMD Radeon Cloud（ROCm 7.2.1 + MPLib）。来源：赛事介绍列出的 AMD 代码参考样例（Robotwin-radeon-cloud）Reproduce_Guide。
ROBOTWIN_DISABLE_CUROBO=1
ROBOTWIN_EE_PLANNER=mplib
AITER_TRITON_ONLY=1
FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE
PYOPENGL_PLATFORM=egl
SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
GPU_VISIBLE_VAR=HIP_VISIBLE_DEVICES
