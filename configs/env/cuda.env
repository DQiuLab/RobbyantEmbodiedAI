# NVIDIA CUDA（AutoDL 自测环境）。官方 RoboTwin 默认用 CuRobo 规划器，CuRobo 路径我们未实测。
GPU_VISIBLE_VAR=CUDA_VISIBLE_DEVICES
# 自测与 AMD 路径一致使用 MPLib 规划器（不编译 CuRobo），见 D-08。官方 CuRobo 评测删掉下两行即可。
ROBOTWIN_DISABLE_CUROBO=1
ROBOTWIN_EE_PLANNER=mplib
PYOPENGL_PLATFORM=egl
# 容器 CPU 配额（AutoDL 每卡 16 核）远小于宿主机核数（128）：不限制时每个进程/worker 都开 128 个线程，严重争抢。
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
