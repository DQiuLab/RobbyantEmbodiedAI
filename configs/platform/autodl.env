# AutoDL 容器实例（无 Docker，conda 环境由 scripts/autodl/setup_env.sh 创建在数据盘，系统盘只有 30 GB）。见 D-08。
ROBOTWIN_ROOT=/root/autodl-tmp/RoboTwin
PY=/root/autodl-tmp/envs/rt/bin/python
LEROBOT_PY=/root/autodl-tmp/envs/lerobot/bin/python
RUNTIME=/root/autodl-tmp/runtime
DATA_ROOT=/root/autodl-tmp/data
ENV_PROFILE=configs/env/cuda.env
# 默认值为初版 LoRA 配置，最终流程见 train.sh
TRAIN_CONFIG=configs/train/autodl_lora.yaml
