# 初版 AMD 方案，未用于最终权重。AMD Radeon Cloud `robotwin` 镜像（external-data）。见 AMD 参考样例 Robotwin-radeon-cloud/Reproduce_Guide.md。
ROBOTWIN_ROOT=/RoboTwin
PY=/opt/robotwin-env/bin/python
LEROBOT_PY=/opt/lerobot-env/bin/python
RUNTIME=/workspace/runtime
DATA_ROOT=/models/robotwin-persistent/data
ENV_PROFILE=configs/env/rocm.env
TRAIN_CONFIG=configs/train/main.yaml
